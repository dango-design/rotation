{
  "expo": {
    "name": "Rotation",
    "slug": "rotation",
    "version": "0.1.0",
    "owner": "deniseango",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/802c9149-1e61-493b-90e0-76f9e9a06bf9"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rotation",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F0EA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dangodesign.rotation",
      "infoPlist": {
        "NSCameraUsageDescription": "Rotation uses the camera to photograph pieces for your closet.",
        "NSPhotoLibraryUsageDescription": "Rotation adds photos of your clothes to your closet."
      }
    },
    "android": {
      "package": "com.dangodesign.rotation",
      "adaptiveIcon": {
        "backgroundColor": "#F3F0EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F0EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rotation adds photos of your clothes to your closet.",
          "cameraPermission": "Rotation uses the camera to photograph pieces for your closet."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "802c9149-1e61-493b-90e0-76f9e9a06bf9"
      }
    }
  }
}

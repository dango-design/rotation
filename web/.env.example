# Copy to .env.local. Everything here is optional.

# Photo tagging with Claude. Server-only.
ANTHROPIC_API_KEY=

# Accounts and sync (decisions 013 and 014). With these set, building a closet and saving need a sign-in; leave them
# empty to keep the closet in the browser with no sign-in, for local development.
# Both are sent to the browser, so use the publishable key, never a secret one.
# Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://ssmiunjctsigikbwdfpc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
